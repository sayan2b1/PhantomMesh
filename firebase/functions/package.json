{
  "name": "phantom-mesh-functions",
  "version": "1.0.0",
  "description": "PhantomMesh Firebase Cloud Functions — bcrypt custom token auth and scheduled data wipes",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "lint": "eslint src/**/*.ts"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0"
  },
  "private": true
}
